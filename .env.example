# SMTP credentials used by /api/contact to send messages from the contact form.
# Example values below work with Gmail (use an App Password, not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: address that receives contact form messages. Defaults to SMTP_USER.
CONTACT_TO_EMAIL=ma.bouabdelli@esi-sba.dz
